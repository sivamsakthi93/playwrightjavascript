//duplicate number in the array
let fgh = [3, 6, 8, 6, 9, 3, 1];
let seen = {};
let dup = [];

for (let x of fgh) {
    if (seen[x]) {
        dup.push(x);
    } else {
        seen[x] = true;
    }
}
console.log(dup); // [6, 3]

//reverse order
let arr = [10, 2, 33, 4];

// Ascending order
arr.sort((a, b) => a - b);
console.log(arr); // [2, 4, 10, 33]

// Descending order
arr.sort((a, b) => b - a);
console.log(arr); // [33, 10, 4, 2]
